Anagrams

import java.util.*;
class Solution {  
    public boolean anagramStrings(String s, String t) {
        
        if (s.length() != t.length()) return false;
        int [] arr = new int[256];
        for (char c : s.toCharArray()) arr[c - 'a']++;
        for (char c : t.toCharArray()) arr[c - 'a']--;  

        for (int i=0; i<arr.length; i++){
            if (arr[i] != 0) return false;
        }
        return true;
    }
}
