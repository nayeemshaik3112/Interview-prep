Find Missing Number in Array
// O(n) time, O(1) space — XOR method

public int missingNumber(int[] nums) {
    int xor = nums.length;
    for (int i = 0; i < nums.length; i++)
        xor ^= i ^ nums[i];
    return xor;
}
